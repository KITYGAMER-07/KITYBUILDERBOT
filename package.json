{
  "name": "telegram-rich-message-builder",
  "version": "1.0.0",
  "description": "Telegram Rich Message Visual Editor & Mini App for Channel Owners",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "node api/index.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"node api/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "start": "node api/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "form-data": "^4.0.4",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
