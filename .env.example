# Telegram Bot API Token from @BotFather (set this as a Vercel Secret)
TELEGRAM_BOT_TOKEN=

# Optional Port for local testing
PORT=5000

# Supabase Storage for media larger than Vercel's 4 MB request limit.
# Create a public Storage bucket named rich-media before enabling these values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=rich-media

# These two are safe for the browser bundle and are required at Vite build time.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
